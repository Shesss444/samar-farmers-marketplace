# Copy this to .env and set values
# MongoDB connection string (e.g. mongodb://localhost:27017/samar)
MONGODB_URI=

# JWT secret for signing tokens (set a strong secret in production)
JWT_SECRET=

# Port for the backend server
PORT=4000

# TextBee SMS (https://app.textbee.dev -> API Keys; install the TextBee app on your Android phone)
TEXTBEE_API_KEY=
# Optional: device ID from the TextBee dashboard; leave blank to use your default device
TEXTBEE_DEVICE_ID=
